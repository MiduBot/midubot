# Discord Configuration
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_PREFIX=m!

# Turso Database Configuration
TURSO_CONNECTION_URL=libsql://your_database_name-your_username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Environment
NODE_ENV=development
LOG_LEVEL=info

# HTTP healthcheck for Coolify/Docker (GET /health → 200 after Discord ready)
HEALTH_PORT=3000


# OpenAI-compatible API root. The client appends /chat/completions.
AI_API_URL=https://your-openai-compatible-endpoint/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=deepseek-v4-flash
# Optional chatbot-only model. Falls back to AI_MODEL.
# AI_CHAT_MODEL=your_vision_or_chat_model
# Enable only when AI_CHAT_MODEL accepts image input.
AI_CHAT_VISION_ENABLED=false
JOB_CHANNEL_ID=your_channel_id_here

# Superdev — comma-separated user IDs with unrestricted access to all commands
SUPERDEV=398321973404368927,another_id_here
